From cea723056aa39004c1ac92ad1fe957e511d63ff6 Mon Sep 17 00:00:00 2001
From: EscapeA <EscapeA@users.noreply.github.com>
Date: Sun, 16 Aug 2026 22:24:43 +0800
Subject: [PATCH 4/5] fix(pwa): cache-first for brand assets so logo never hits
 network on cold start
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- logo.png, favicon, icons, manifest.webmanifest, offline.html now use
  Cache-First (previously SWR, which issued a background network request
  on every load even when cached — cold-start logo looked network-bound)
- fix precache URL: /manifest.json → /manifest.webmanifest (frontend
  references the real file; /manifest.json was an SPA-fallback HTML blob)
---
 packages/client/public/sw.js | 23 ++++++++++++++++++++---
 1 file changed, 20 insertions(+), 3 deletions(-)

diff --git a/packages/client/public/sw.js b/packages/client/public/sw.js
index c623e129..bede7c61 100644
--- a/packages/client/public/sw.js
+++ b/packages/client/public/sw.js
@@ -10,13 +10,26 @@ const API_CACHE = `hermes-api-${CACHE_VERSION}`;
 const PRECACHE_URLS = [
   '/',
   '/offline.html',
-  '/manifest.json',
+  '/manifest.webmanifest',
   '/icon-192.png',
   '/icon-512.png',
   '/logo.png',
   '/favicon.ico',
 ];
 
+// Brand/static resources that are effectively immutable (no content hash in
+// filename, but change only across app releases). Cache-First so cold starts
+// never hit the network for them; SW version bump clears the cache on activate.
+const CACHE_FIRST_PATHS = [
+  '/logo.png',
+  '/logo-original.png',
+  '/favicon.ico',
+  '/icon-192.png',
+  '/icon-512.png',
+  '/manifest.webmanifest',
+  '/offline.html',
+];
+
 // Paths that must NEVER be intercepted (API, WebSocket, Socket.IO)
 const EXCLUDED_PATHS = [
   '/api/',
@@ -48,6 +61,10 @@ function isHashedAsset(url) {
   return url.pathname.match(/\/assets\/(js|css|images|fonts)\/.*-[a-zA-Z0-9_-]{8,}\./);
 }
 
+function isCacheFirstAsset(url) {
+  return CACHE_FIRST_PATHS.includes(url.pathname);
+}
+
 // --- Install: precache essential resources ---
 self.addEventListener('install', (event) => {
   event.waitUntil(
@@ -94,8 +111,8 @@ self.addEventListener('fetch', (event) => {
   // Only handle same-origin requests (session list already handled above)
   if (url.origin !== self.location.origin) return;
 
-  if (isHashedAsset(url)) {
-    // Cache-First for hashed assets (immutable due to hash in filename)
+  if (isHashedAsset(url) || isCacheFirstAsset(url)) {
+    // Cache-First for immutable assets (content hash or brand resources)
     event.respondWith(cacheFirst(request, STATIC_CACHE));
   } else if (url.pathname === '/' || url.pathname === '/index.html') {
     // Network-First for navigation (always try fresh)
-- 
