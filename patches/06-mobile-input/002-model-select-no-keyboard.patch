From 3364067a17ea96fa231ade754c2d1d82e00b4569 Mon Sep 17 00:00:00 2001
From: EscapeA <EscapeA@users.noreply.github.com>
Date: Sat, 4 Jul 2026 11:56:09 +0800
Subject: [PATCH] feat: disable model select filter on mobile to prevent
 keyboard popup

The filterable NSelect in the new-chat drawer triggers the virtual
keyboard on mobile when tapping the model dropdown. With Octopus
aggregating models into a short list, the search box is unnecessary on
mobile and hurts the interaction. Bind :filterable to !isMobile so the
filter stays available on desktop while mobile gets a simple dropdown.
---
 packages/client/src/components/hermes/chat/ChatPanel.vue | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/packages/client/src/components/hermes/chat/ChatPanel.vue b/packages/client/src/components/hermes/chat/ChatPanel.vue
index b1beb9327..bf772981f 100644
--- a/packages/client/src/components/hermes/chat/ChatPanel.vue
+++ b/packages/client/src/components/hermes/chat/ChatPanel.vue
@@ -2937,7 +2937,7 @@ async function handleSessionModelCustomSubmit() {
               :options="newChatModelOptions"
               :loading="newChatModelsLoading"
               :disabled="newChatLoading || newChatModelsLoading || !newChatProvider"
-              filterable
+              :filterable="!isMobile"
             />
           </label>
           <label v-if="isNewChatCodingAgent && effectiveNewChatAgentMode === 'scoped'" class="new-chat-field">
