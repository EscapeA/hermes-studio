From 2299dd82abd0d9cccf3d3c67b595c25127b2f74b Mon Sep 17 00:00:00 2001
From: EscapeA <escapea@users.noreply.github.com>
Date: Thu, 15 Oct 2026 12:00:00 +0800
Subject: [PATCH] fix(mobile-nav): drop the drawer's own close row and the
 ghost rail entries
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

- StudioNavigationRail: drop the group-chat / workflow / device-connections
  entries (their routes and views are removed by the fork) and point the chat
  entry at the existing sidebar.chat key instead of the removed
  sidebar.singleChat one, so a raw key is never rendered.
- MobileNavigationDrawer: the drawer's own 40px close row is gone (the page
  sidebar's own close button is the affordance again, un-suppressed).
- ChatPanel: tighten the mobile page-sidebar header paddings now that the ☰ no
  longer floats over it.

The 0.7.26 version of this patch also overrode the drawer's top safe-area inset
to a hardcoded 0 (the K60 shell then double-padded the content, which read as a
dead band). That override is dropped here: with the web-to-app shell running
fullscreen + persistent transparent status bar the window is truly edge-to-edge,
the shell reserves no top padding, and env(safe-area-inset-top) is the only
correct inset — overriding it buried the drawer's first row under the status
bar. The upstream inset lines stand as they are.
---
 .../layout/MobileNavigationDrawer.vue         | 26 +++----------------
 .../layout/StudioNavigationRail.vue           |  4 ---
 2 files changed, 3 insertions(+), 27 deletions(-)

diff --git a/packages/client/src/components/layout/MobileNavigationDrawer.vue b/packages/client/src/components/layout/MobileNavigationDrawer.vue
index e98ffafe1..55a49ce1d 100644
--- a/packages/client/src/components/layout/MobileNavigationDrawer.vue
+++ b/packages/client/src/components/layout/MobileNavigationDrawer.vue
@@ -1,6 +1,5 @@
 <script setup lang="ts">
 import { NDrawer } from 'naive-ui'
-import { useI18n } from 'vue-i18n'
 import StudioNavigationRail from './StudioNavigationRail.vue'
 
 defineProps<{ show: boolean; hasSidebar: boolean }>()
@@ -8,7 +7,6 @@ const emit = defineEmits<{
   'update:show': [show: boolean]
   target: [element: HTMLElement | null]
 }>()
-const { t } = useI18n()
 </script>
 
 <template>
@@ -23,9 +21,6 @@ const { t } = useI18n()
     <div class="studio-mobile-navigation">
       <StudioNavigationRail />
       <section v-show="hasSidebar" class="studio-mobile-navigation__panel">
-        <button class="studio-mobile-navigation__close" type="button" :aria-label="t('common.close')" @click="emit('update:show', false)">
-          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m18 6-12 12M6 6l12 12" /></svg>
-        </button>
         <div :ref="element => emit('target', element as HTMLElement | null)" class="studio-mobile-navigation__content" />
       </section>
     </div>
@@ -58,23 +53,6 @@ const { t } = useI18n()
   padding-bottom: env(safe-area-inset-bottom, 0px);
   border-inline-start: var(--border-width, 1px) solid $border-color;
 }
-.studio-mobile-navigation__close {
-  display: grid;
-  place-items: center;
-  align-self: flex-end;
-  flex-shrink: 0;
-  width: 32px;
-  height: 32px;
-  margin: 8px 8px 0;
-  border: 0;
-  border-radius: $radius-sm;
-  color: $text-secondary;
-  background: transparent;
-  cursor: pointer;
-
-  &:hover { color: $text-primary; }
-  &:focus-visible { outline: 2px solid $accent-primary; }
-}
 .studio-mobile-navigation .studio-mobile-navigation__content {
   position: relative;
   display: flex;
@@ -102,7 +80,9 @@ const { t } = useI18n()
     pointer-events: auto;
   }
 
-  :deep(.session-close-btn),
+  // Keep each page sidebar's own close control working inside the drawer (it is
+  // the single close affordance now that the drawer's own X row is gone); only
+  // the desktop-only collapse toggles are suppressed.
   :deep(.workflow-sidebar-close),
   :deep(.collapse-btn),
   :deep(.hermes-config-collapse),
