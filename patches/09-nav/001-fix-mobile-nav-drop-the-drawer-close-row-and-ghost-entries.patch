       </section>
     </div>
@@ -60,23 +55,6 @@ const { t } = useI18n()
   padding-bottom: env(safe-area-inset-bottom, 0px);
   border-inline-start: var(--border-width, 1px) solid $border-color;
 }
-.studio-mobile-navigation__close {
-  display: grid;
-  place-items: center;
-  align-self: flex-end;
