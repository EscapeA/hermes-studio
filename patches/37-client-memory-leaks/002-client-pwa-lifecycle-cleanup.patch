From 1dd6fc31a2c6c3cb3f8da6c02cb57fb88f7ac632 Mon Sep 17 00:00:00 2001
From: EscapeA <escapea@users.noreply.github.com>
Date: Wed, 7 Oct 2026 00:03:10 +0800
Subject: [PATCH] fix(client): stop leaking PWA service worker resources

usePwa() re-registered the service worker on every call, each time adding
another controllerchange listener and another 30-minute update timer that
were never removed. Guard registration behind a module-level promise so the
SW/ listener / timer exist once page-wide, and clear the interval plus
remove the controllerchange listener on unmount.
---
 packages/client/src/composables/usePwa.ts | 82 +++++++++++++++--------
 1 file changed, 53 insertions(+), 29 deletions(-)

diff --git a/packages/client/src/composables/usePwa.ts b/packages/client/src/composables/usePwa.ts
index 1ee3936c6..66dcf2893 100644
--- a/packages/client/src/composables/usePwa.ts
+++ b/packages/client/src/composables/usePwa.ts
@@ -1,47 +1,71 @@
-import { ref, onMounted } from 'vue'
+import { ref, onMounted, onUnmounted } from 'vue'
 
 const updateAvailable = ref(false)
 let swRegistration: ServiceWorkerRegistration | null = null
 
+// Module-level gate: the SW, its one-time `controllerchange` listener and the
+// 30-minute update timer are shared page-wide resources. Without the gate each
+// usePwa() call re-registered the SW and stacked another listener + interval
+// that were never torn down.
+let swRegisterPromise: Promise<void> | null = null
+let swUpdateIntervalId: ReturnType<typeof setInterval> | null = null
+let swControllerChangeHandler: (() => void) | null = null
+
 export function usePwa() {
   onMounted(() => {
     registerSW()
   })
 
-  async function registerSW() {
-    if (!('serviceWorker' in navigator)) return
+  onUnmounted(() => {
+    if (swUpdateIntervalId !== null) {
+      clearInterval(swUpdateIntervalId)
+      swUpdateIntervalId = null
+    }
+    if (swControllerChangeHandler) {
+      navigator.serviceWorker.removeEventListener('controllerchange', swControllerChangeHandler)
+      swControllerChangeHandler = null
+    }
+  })
 
-    // controllerchange listener BEFORE register (skill pitfall)
-    let refreshing = false
-    navigator.serviceWorker.addEventListener('controllerchange', () => {
-      if (refreshing) return
-      refreshing = true
-      window.location.reload()
-    })
+  function registerSW() {
+    if (!('serviceWorker' in navigator)) return
+    if (swRegisterPromise) return swRegisterPromise
+    swRegisterPromise = (async () => {
+      // controllerchange listener BEFORE register (skill pitfall)
+      let refreshing = false
+      swControllerChangeHandler = () => {
+        if (refreshing) return
+        refreshing = true
+        window.location.reload()
+      }
+      navigator.serviceWorker.addEventListener('controllerchange', swControllerChangeHandler)
 
-    try {
-      const reg = await navigator.serviceWorker.register('/sw.js', { scope: '/' })
-      swRegistration = reg
+      try {
+        const reg = await navigator.serviceWorker.register('/sw.js', { scope: '/' })
+        swRegistration = reg
 
-      if (reg.waiting) {
-        updateAvailable.value = true
-      }
+        if (reg.waiting) {
+          updateAvailable.value = true
+        }
 
-      reg.addEventListener('updatefound', () => {
-        const nw = reg.installing
-        if (!nw) return
-        nw.addEventListener('statechange', () => {
-          if (nw.state === 'installed' && navigator.serviceWorker.controller) {
-            updateAvailable.value = true
-          }
+        reg.addEventListener('updatefound', () => {
+          const nw = reg.installing
+          if (!nw) return
+          nw.addEventListener('statechange', () => {
+            if (nw.state === 'installed' && navigator.serviceWorker.controller) {
+              updateAvailable.value = true
+            }
+          })
         })
-      })
 
-      // Periodic update check every 30 minutes
-      setInterval(() => reg.update(), 30 * 60 * 1000)
-    } catch (err) {
-      console.warn('SW registration failed:', err)
-    }
+        // Periodic update check every 30 minutes
+        if (swUpdateIntervalId !== null) clearInterval(swUpdateIntervalId)
+        swUpdateIntervalId = setInterval(() => reg.update(), 30 * 60 * 1000)
+      } catch (err) {
+        console.warn('SW registration failed:', err)
+      }
+    })()
+    return swRegisterPromise
   }
 
   function applyUpdate() {
