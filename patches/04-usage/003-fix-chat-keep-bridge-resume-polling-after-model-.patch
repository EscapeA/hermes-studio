From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: EscapeA <EscapeA@users.noreply.github.com>
Date: Sun, 19 Jul 2026 17:32:59 +0800
Subject: [PATCH] fix(chat): keep bridge resume polling after model.usage apply
 failures

Wrap resume snapshot model.usage handling so usage/context UI updates cannot
abort cursor advancement. Update resume test mocks for the new usage helpers.
---
 .../services/chat-run/handle-bridge-run.ts      | 17 +++++++++++++----
 1 file changed, 13 insertions(+), 4 deletions(-)

diff --git a/packages/server/src/modules/studio/services/chat-run/handle-bridge-run.ts b/packages/server/src/modules/studio/services/chat-run/handle-bridge-run.ts
index b6d787e44..315d6b1f0 100644
--- a/packages/server/src/modules/studio/services/chat-run/handle-bridge-run.ts
+++ b/packages/server/src/modules/studio/services/chat-run/handle-bridge-run.ts
@@ -1088,10 +1088,19 @@ export async function resumeBridgeRun(
       if (!event || typeof event !== 'object' || Array.isArray(event)) continue
       const bridgeEvent = event as Record<string, unknown>
       if (bridgeEvent.event === 'model.usage') {
-        recordBridgeModelUsage(sessionId, runId, bridgeEvent, profile, {
-          model: args.model,
-          provider: args.provider,
-        }, { state, emit })
+        try {
+          recordBridgeModelUsage(sessionId, runId, bridgeEvent, profile, {
+            model: args.model,
+            provider: args.provider,
+          }, { state, emit })
+        } catch (usageErr) {
+          // Never block resume cursor advancement on usage accounting failures.
+          bridgeLogger.warn({
+            err: usageErr instanceof Error ? { message: usageErr.message, name: usageErr.name } : usageErr,
+            sessionId,
+            runId,
+          }, '[chat-run-socket] failed to apply model.usage during bridge resume snapshot')
+        }
       }
     }
     const output = typeof snapshot.output === 'string' ? snapshot.output : deltas.join('')
