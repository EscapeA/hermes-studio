-        ? requestedEndLine
-        : startLine
-    toolPanelStore.closeWorkspaceDiff()
-    filesStore.closePreview()
-    void filesStore.openGroupWorkspacePreview(
-        roomId,
-        path,
-        fileName,
-        -1,
