From 91226e5afa941cd292062525f0cf4b72f83f5d14 Mon Sep 17 00:00:00 2001
From: EscapeA <escapea@users.noreply.github.com>
Date: Tue, 13 Oct 2026 18:04:05 +0800
Subject: [PATCH] fix(chat): finish the agent deployment when the fork has no
 landing target

Upstream #3378 flies the new-chat Agent card into the run indicator's thinking
avatar and masks the session until it lands. The fork's run indicator is
text-only (patches/05-chat/019), so no [data-agent-deployment-target] is ever
rendered: the card hovered under the shade until the next message. Bail out
right after the takeoff window when no target exists; a target that exists but
has not finished loading still waits, exactly like upstream.

The upstream e2e spec is adapted to the same reality (overlay clears, no
avatar, scrolled-card centring kept).
---
 .../hermes/chat/agentDeployment.mjs           |  6 ++
 tests/e2e/agent-deployment.spec.ts            | 89 ++++++-------------
 2 files changed, 31 insertions(+), 64 deletions(-)

diff --git a/packages/client/src/components/hermes/chat/agentDeployment.mjs b/packages/client/src/components/hermes/chat/agentDeployment.mjs
index ce813b9c1..43065b42c 100644
--- a/packages/client/src/components/hermes/chat/agentDeployment.mjs
+++ b/packages/client/src/components/hermes/chat/agentDeployment.mjs
@@ -215,6 +215,12 @@ function captureDeployment(source) {
       overlay.dataset.phase = 'waiting';
       const hover = (elapsed - 1400) / 1000;
       pose = { ...pose, y: cy - Math.sin(hover * 2.4) * 3, ry: Math.sin(hover * 1.6) * 1.5 };
+      // Fork: the run indicator is text-only (no thinking avatar), so this
+      // session never renders a landing target. Upstream would hover the card
+      // under the shade forever waiting for one; bail out after the takeoff
+      // window instead of leaving the overlay on screen. A target that exists
+      // but has not finished loading still waits, exactly like upstream.
+      if (!target) { fadeStarted = now; overlay.dataset.phase = 'finishing'; }
     }
     glow.style.opacity = String(.8 * clamp((elapsed - 120) / 360, 0, 1));
     floor.style.opacity = String(.8 * clamp((elapsed - 120) / 360, 0, 1) * (1 - clamp((elapsed - 950) / 240, 0, 1)));
