From a5fa2777c1a9c1cdcb996f4809ca4edbf1a1749d Mon Sep 17 00:00:00 2001
From: EscapeA <escapea@users.noreply.github.com>
Date: Thu, 15 Oct 2026 09:43:16 +0800
Subject: [PATCH] feat(chat): mark working sessions with a live dot in the
 title row

Upstream hangs the streaming indicator off the session agent-logo wrapper
(.session-item-agent-logo-wrap.streaming::before). The fork removes avatars
wholesale, which left the streaming prop declared but unused and the indicator
gone, so a session that was working looked identical to an idle one.

Restore it as a standalone dot in the title row: no avatar needed, and it stays
visible whichever optional rows (identity, category) the item renders. The
already-present "does not show the live-status indicator when not streaming"
assertion becomes meaningful again.
---
 .../hermes/chat/SessionListItem.vue           | 41 +++++++++++++++++++
 packages/client/src/i18n/locales/ar.ts        |  1 +
 packages/client/src/i18n/locales/de.ts        |  1 +
 packages/client/src/i18n/locales/en.ts        |  1 +
 packages/client/src/i18n/locales/es.ts        |  1 +
 packages/client/src/i18n/locales/fr.ts        |  1 +
 packages/client/src/i18n/locales/ja.ts        |  1 +
 packages/client/src/i18n/locales/ko.ts        |  1 +
 packages/client/src/i18n/locales/pt.ts        |  1 +
 packages/client/src/i18n/locales/ru.ts        |  1 +
 packages/client/src/i18n/locales/zh-TW.ts     |  1 +
 packages/client/src/i18n/locales/zh.ts        |  1 +
 tests/client/session-list-item.test.ts        | 15 +++++++
 13 files changed, 67 insertions(+)

diff --git a/packages/client/src/components/hermes/chat/SessionListItem.vue b/packages/client/src/components/hermes/chat/SessionListItem.vue
index 623e30029..fb1004539 100644
--- a/packages/client/src/components/hermes/chat/SessionListItem.vue
+++ b/packages/client/src/components/hermes/chat/SessionListItem.vue
@@ -124,6 +124,12 @@ onUnmounted(() => {
             <PinIcon width="13" height="13" filled />
           </span>
           <span v-if="completedUnread" class="session-item-unread-dot" aria-hidden="true" />
+          <span
+            v-if="streaming"
+            class="session-item-live-dot"
+            :title="t('chat.sessionLive')"
+            :aria-label="t('chat.sessionLive')"
+          />
           <span class="session-item-title" dir="auto">
             {{ session.title }}
           </span>
@@ -290,6 +296,41 @@ onUnmounted(() => {
   box-shadow: 0 0 0 3px rgba(var(--accent-primary-rgb), 0.12);
 }
 
+/* Live/working indicator lives in the title row so it stays visible no matter
+   which optional rows (identity, category) the session renders. */
+.session-item-live-dot {
+  flex: 0 0 auto;
+  width: 7px;
+  height: 7px;
+  margin-top: 5px;
+  border-radius: 50%;
+  background: #171717;
+  box-shadow:
+    0 0 0 2px rgba(23, 23, 23, 0.12),
+    0 0 8px rgba(255, 107, 107, 0.35);
+  animation: session-live-pulse 1.5s ease-in-out infinite;
+}
+
+.dark .session-item-live-dot {
+  background: #f5f5f5;
+  box-shadow:
+    0 0 0 2px rgba(245, 245, 245, 0.16),
+    0 0 10px rgba(255, 107, 107, 0.4);
+}
+
+@keyframes session-live-pulse {
+  0%,
+  100% {
+    transform: scale(1);
+    opacity: 1;
+  }
+
+  50% {
+    transform: scale(0.82);
+    opacity: 0.72;
+  }
+}
+
 .session-item-time {
   flex: 0 0 auto;
   font-size: 11px;
