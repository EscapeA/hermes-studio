-    makeNode(id, t('workflow.newNodeTitle', { count: nextNodeIndex.value }), getNextVisibleNodePosition()),
-  ]
-  nextNodeIndex.value += 1
-  ensureSkillOptionsForVisibleNodes()
-  await nextTick()
-}
