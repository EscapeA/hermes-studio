-  const preset = WORKFLOW_RUN_BUDGET_PRESETS.find(option => option.value === choice)?.minutes
-  const minutes = choice === 'custom' ? customMinutes : preset
-  if (!isWorkflowRunBudgetValid(choice, minutes ?? null)) {
