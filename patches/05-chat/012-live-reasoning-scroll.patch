From 63ac060d90479bbd1102b7745b7c0dbd04bd95f2 Mon Sep 17 00:00:00 2001
From: EscapeA <EscapeA@users.noreply.github.com>
Date: Thu, 6 Aug 2026 23:29:20 +0800
Subject: [PATCH] feat(client): auto-scroll live reasoning body to bottom while
 streaming

---
 .../hermes/chat/LiveReasoningStatus.vue       | 21 ++++++++++++++++---
 1 file changed, 18 insertions(+), 3 deletions(-)

diff --git a/packages/client/src/components/hermes/chat/LiveReasoningStatus.vue b/packages/client/src/components/hermes/chat/LiveReasoningStatus.vue
index 6c25c255..0e4ae906 100644
--- a/packages/client/src/components/hermes/chat/LiveReasoningStatus.vue
+++ b/packages/client/src/components/hermes/chat/LiveReasoningStatus.vue
@@ -1,17 +1,32 @@
 <script setup lang="ts">
-import { defineAsyncComponent } from 'vue'
+import { defineAsyncComponent, nextTick, ref, watch } from 'vue'
 import { useI18n } from 'vue-i18n'
 import thinkingImage from '@/assets/thinking.gif'
 
 const MarkdownRenderer = defineAsyncComponent(async () => (await import('./MarkdownRenderer.vue')).default)
 
-defineProps<{
+const props = defineProps<{
   reasoning?: string | null
   reasoningId?: string | number | null
   elapsed: string
 }>()
 
 const { t } = useI18n()
+
+const reasoningBodyRef = ref<HTMLElement | null>(null)
+
+// 流式思考内容更新时自动滚动到底部，始终展示最新输出的部分
+watch(
+  () => props.reasoning,
+  () => {
+    nextTick(() => {
+      requestAnimationFrame(() => {
+        const el = reasoningBodyRef.value
+        if (el) el.scrollTop = el.scrollHeight
+      })
+    })
+  },
+)
 </script>
 
 <template>
@@ -38,7 +53,7 @@ const { t } = useI18n()
         <span aria-hidden="true">💭</span>
         <span>{{ t('chat.thinkingLabel') }}</span>
       </div>
-      <div class="live-reasoning-body">
+      <div ref="reasoningBodyRef" class="live-reasoning-body">
         <MarkdownRenderer :content="reasoning" />
       </div>
     </div>
-- 
