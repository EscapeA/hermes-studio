Subject: [PATCH 2/2] perf(chat): drop fast-first page to 20 messages for even
 snappier first paint

---
 packages/client/src/stores/hermes/chat.ts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/packages/client/src/stores/hermes/chat.ts b/packages/client/src/stores/hermes/chat.ts
index 499a98c2..e990e34d 100644
--- a/packages/client/src/stores/hermes/chat.ts
+++ b/packages/client/src/stores/hermes/chat.ts
@@ -24,7 +24,7 @@ export const LIVE_CHAT_MAX_LOADED_MESSAGES = 300
 // messages from the paginated REST endpoint immediately, then let the socket
 // resume fill in the full state (usage, queue, in-flight events) in the
 // background. Kept small so the first paint is nearly instant.
-export const SESSION_FAST_FIRST_PAGE_SIZE = 50
+export const SESSION_FAST_FIRST_PAGE_SIZE = 20
 const LEGACY_WORKSPACE_RUN_CHANGE_MESSAGE_PREFIX = 'workspace-run-change:'
 type ChatAgentId = 'hermes' | 'claude' | 'codex' | 'pi' | 'ekko-agent'
 
