From 85df945a306e4fde2d8079789d5880392a11799c Mon Sep 17 00:00:00 2001
From: EscapeA <EscapeA@users.noreply.github.com>
Date: Mon, 20 Jul 2026 22:10:11 +0800
Subject: [PATCH] fix(chat): wrap long session titles in sidebar list

Allow session list titles to wrap and grow the row height instead of
single-line ellipsis, keeping time/delete icons top-aligned.
---
 .../hermes/chat/SessionListItem.vue           | 19 +++++++++++++------
 1 file changed, 13 insertions(+), 6 deletions(-)

diff --git a/packages/client/src/components/hermes/chat/SessionListItem.vue b/packages/client/src/components/hermes/chat/SessionListItem.vue
index 82c983951..8792af9bd 100644
--- a/packages/client/src/components/hermes/chat/SessionListItem.vue
+++ b/packages/client/src/components/hermes/chat/SessionListItem.vue
@@ -199,7 +199,7 @@ onUnmounted(() => {
 .session-item {
   position: relative;
   display: flex;
-  align-items: center;
+  align-items: flex-start;
   justify-content: space-between;
   width: 100%;
   padding: 8px 10px;
@@ -263,7 +263,7 @@ onUnmounted(() => {
 
 .session-item-title-row {
   display: flex;
-  align-items: center;
+  align-items: flex-start;
   justify-content: space-between;
   gap: 10px;
   min-width: 0;
@@ -271,7 +271,7 @@ onUnmounted(() => {
 
 .session-item-title-main {
   display: flex;
-  align-items: center;
+  align-items: flex-start;
   gap: 6px;
   flex: 1 1 auto;
   min-width: 0;
@@ -282,9 +282,10 @@ onUnmounted(() => {
   flex: 1 1 auto;
   min-width: 0;
   font-size: 13px;
-  white-space: nowrap;
-  overflow: hidden;
-  text-overflow: ellipsis;
+  line-height: 1.35;
+  white-space: normal;
+  overflow-wrap: anywhere;
+  word-break: break-word;
 }
 
 .session-item-pin {
@@ -292,6 +293,7 @@ onUnmounted(() => {
   align-items: center;
   justify-content: center;
   flex-shrink: 0;
+  margin-top: 2px;
   color: var(--accent-primary);
 }
 
@@ -299,6 +301,7 @@ onUnmounted(() => {
   flex: 0 0 auto;
   width: 6px;
   height: 6px;
+  margin-top: 5px;
   border-radius: 50%;
   background: var(--accent-primary);
   box-shadow: 0 0 0 3px rgba(var(--accent-primary-rgb), 0.12);
@@ -306,8 +309,11 @@ onUnmounted(() => {
 
 .session-item-time {
   flex: 0 0 auto;
+  margin-top: 1px;
   font-size: 11px;
+  line-height: 1.35;
   color: var(--text-muted);
+  white-space: nowrap;
 }
 
 .session-item-global-icon {
@@ -322,6 +328,7 @@ onUnmounted(() => {
   flex-shrink: 0;
   opacity: 0;
   pointer-events: none;
+  margin-top: 1px;
   padding: 2px;
   border: none;
   background: none;
