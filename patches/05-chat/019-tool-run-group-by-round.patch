From 1ce67c0f137b4fe86cb843d98280a0b0ab3889f2 Mon Sep 17 00:00:00 2001
From: EscapeA <escapea@users.noreply.github.com>
Date: Sat, 5 Sep 2026 20:13:57 +0800
Subject: [PATCH] fix(chat): group tool-run card per user turn not per run_id
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A single user turn can span multiple backend runs (each tool loop
iteration carries its own run_id, surfaced as runMarker by the
frontend). Keying groupCompletedToolsByRun on runMarker produced one
collapsed 'N tool calls' card per run inside the same task (e.g. '52 次
工具调用' and '54 次工具调用' both visible mid-stream).

Group by the nearest preceding user/command message id instead: exactly
one card per user turn, count grows as tools finish, card stays anchored
at the last completed tool of the round.
---
 .../hermes/chat/tool-run-grouping.ts          | 72 ++++++++++++-------
 1 file changed, 45 insertions(+), 27 deletions(-)

diff --git a/packages/client/src/components/hermes/chat/tool-run-grouping.ts b/packages/client/src/components/hermes/chat/tool-run-grouping.ts
index 52b74c2d..5af77160 100644
--- a/packages/client/src/components/hermes/chat/tool-run-grouping.ts
+++ b/packages/client/src/components/hermes/chat/tool-run-grouping.ts
@@ -1,54 +1,72 @@
 import type { Message } from '@/stores/hermes/chat'
 
+/**
+ * Collapse completed tool messages into per-round cards.
+ *
+ * Grouping key: the nearest preceding user/command message id (the "round"
+ * boundary) instead of runMarker. A single user turn can span multiple
+ * backend runs (each tool loop iteration carries its own run_id which the
+ * frontend surfaces as runMarker), so keying on runMarker would produce one
+ * card per run inside the same task — e.g. "52 次工具调用" and "54 次工具调用"
+ * both visible mid-stream. Keying on the input boundary keeps exactly one
+ * card per user turn; the count grows as more tools finish.
+ */
 export function groupCompletedToolsByRun(messages: Message[]): Message[] {
-  const toolsByRun = new Map<string, Message[]>()
-  const runMaxIndex = new Map<string, number>()
+  const toolsByRound = new Map<string, Message[]>()
+  const roundMaxIndex = new Map<string, number>()
+  let lastBoundaryId: string | null = null
   for (let i = 0; i < messages.length; i++) {
     const message = messages[i]
-    const runId = message.role === 'tool' && message.toolStatus !== 'running'
-      ? message.runMarker?.trim()
-      : undefined
-    if (!runId) continue
-    const tools = toolsByRun.get(runId) || []
+    if (message.role === 'user' || message.role === 'command') {
+      lastBoundaryId = message.id
+      continue
+    }
+    if (message.role !== 'tool' || message.toolStatus === 'running') continue
+    const roundKey = lastBoundaryId ?? '__session_start__'
+    const tools = toolsByRound.get(roundKey) || []
     tools.push(message)
-    toolsByRun.set(runId, tools)
-    runMaxIndex.set(runId, i)
+    toolsByRound.set(roundKey, tools)
+    roundMaxIndex.set(roundKey, i)
   }
-  if (toolsByRun.size === 0) return messages
+  if (toolsByRound.size === 0) return messages
 
-  const emittedRuns = new Set<string>()
+  const emittedRounds = new Set<string>()
   const grouped: Message[] = []
+  let currentBoundaryId: string | null = null
   for (let i = 0; i < messages.length; i++) {
     const message = messages[i]
-    const runId = message.role === 'tool' && message.toolStatus !== 'running'
-      ? message.runMarker?.trim()
-      : undefined
-    if (!runId) {
+    if (message.role === 'user' || message.role === 'command') {
+      currentBoundaryId = message.id
+      grouped.push(message)
+      continue
+    }
+    const roundKey = currentBoundaryId ?? '__session_start__'
+    if (message.role !== 'tool' || message.toolStatus === 'running') {
       grouped.push(message)
       continue
     }
-    // Skip earlier completed tools of the same run; emit the collapsed card in
-    // place of the LAST completed tool so it stays near the end of the run
-    // (and near the live view bottom) instead of being anchored at the first
-    // tool call of the run.
-    if (i !== runMaxIndex.get(runId)) continue
-    if (emittedRuns.has(runId)) continue
-    emittedRuns.add(runId)
-    const tools = toolsByRun.get(runId)
+    // Skip earlier completed tools of the same round; emit the collapsed card
+    // in place of the LAST completed tool so it stays near the end of the
+    // round (and near the live view bottom) instead of being anchored at the
+    // first tool call of the round.
+    if (i !== roundMaxIndex.get(roundKey)) continue
+    if (emittedRounds.has(roundKey)) continue
+    emittedRounds.add(roundKey)
+    const tools = toolsByRound.get(roundKey)
     if (!tools?.length) {
       grouped.push(message)
       continue
     }
     grouped.push({
-      id: `tool-run:${runId}`,
+      id: `tool-run:round:${roundKey}`,
       role: 'system',
       content: '',
       timestamp: tools[0].timestamp,
       systemType: 'tool-run',
-      runMarker: runId,
-      toolRunId: runId,
+      runMarker: tools[0].runMarker ?? null,
+      toolRunId: roundKey,
       toolMessages: tools,
     })
   }
   return grouped
-}
\ No newline at end of file
+}
