From 98ff2faa6a9493e134d13a06c30c184f8033a137 Mon Sep 17 00:00:00 2001
From: EscapeA <EscapeA@users.noreply.github.com>
Date: Mon, 20 Jul 2026 19:06:09 +0800
Subject: [PATCH] fix(chat): mobile clarify choices use single-column
 multi-line buttons

Long clarify option labels were truncated on mobile because they shared
approval-float-actions 2-col grid with short approval labels. Scope a
clarify-float-actions class so mobile clarify options stack full-width
and wrap text while approval stays two columns.
---
 .../components/hermes/chat/MessageList.vue    | 33 ++++++++++++++++++-
 1 file changed, 32 insertions(+), 1 deletion(-)

diff --git a/packages/client/src/components/hermes/chat/MessageList.vue b/packages/client/src/components/hermes/chat/MessageList.vue
index 15016bb9d..bdf63350b 100644
--- a/packages/client/src/components/hermes/chat/MessageList.vue
+++ b/packages/client/src/components/hermes/chat/MessageList.vue
@@ -1014,7 +1014,10 @@ defineExpose({
           </div>
           <div class="approval-float-title">{{ t("chat.clarifyTitle") }}</div>
           <div class="approval-float-desc">{{ visibleClarify.question }}</div>
-          <div v-if="visibleClarify.choices && visibleClarify.choices.length" class="approval-float-actions">
+          <div
+            v-if="visibleClarify.choices && visibleClarify.choices.length"
+            class="approval-float-actions clarify-float-actions"
+          >
             <NButton
               v-for="choice in visibleClarify.choices"
               :key="choice"
@@ -1214,6 +1217,24 @@ defineExpose({
   border-top: 1px solid $border-color;
 }
 
+/* Clarify choices can be long descriptions — allow multi-line labels. */
+.clarify-float-actions {
+  :deep(.n-button) {
+    height: auto;
+    white-space: normal;
+    text-align: left;
+    line-height: 1.35;
+    padding-top: 8px;
+    padding-bottom: 8px;
+  }
+
+  :deep(.n-button .n-button__content) {
+    white-space: normal;
+    line-height: 1.35;
+    text-align: left;
+  }
+}
+
 .clarify-float-input-row {
   display: flex;
   gap: 8px;
@@ -1446,6 +1467,16 @@ defineExpose({
     }
   }
 
+  /* Long clarify options need full width; keep approval 2-col short labels. */
+  .approval-float-actions.clarify-float-actions {
+    grid-template-columns: minmax(0, 1fr);
+
+    :deep(.n-button) {
+      width: 100%;
+      justify-content: flex-start;
+    }
+  }
+
   .clarify-float-input-row {
     flex-direction: column;
 
-- 
2.53.0

