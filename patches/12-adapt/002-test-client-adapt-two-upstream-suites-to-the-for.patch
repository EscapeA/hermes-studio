From e088cc781cfcc17e0e22302f490da1942ac4a4b6 Mon Sep 17 00:00:00 2001
From: EscapeA <escapea@users.noreply.github.com>
Date: Mon, 28 Sep 2026 23:07:20 +0800
Subject: [PATCH] test(client): adapt two upstream suites to the fork's
 composer behavior

- search-navigation: a plain switch to another session fires the fork's
  fast-first fetch, so a stopped search flow sees two page requests in total
- chat-input-draft: the context row now shows the percent chip instead of
  the remaining-token text, and the context progress bar is dropped
---
 tests/client/chat-input-draft.test.ts             | 13 ++++++++-----
 tests/client/chat-store-search-navigation.test.ts |  4 +++-
 2 files changed, 11 insertions(+), 6 deletions(-)

diff --git a/tests/client/chat-input-draft.test.ts b/tests/client/chat-input-draft.test.ts
index e9a64e0a8..dbb55fdbc 100644
--- a/tests/client/chat-input-draft.test.ts
+++ b/tests/client/chat-input-draft.test.ts
@@ -502,15 +502,17 @@ describe('ChatInput draft persistence', () => {
 
     expect(wrapper.get('.context-info').text()).toMatch(/2\.0k\s+\//)
     expect(wrapper.get('.context-limit-editable').text()).toBe('256.0k')
-    expect(wrapper.get('.context-info').text()).toContain('chat.contextRemaining 254.0k')
-    expect(wrapper.find('.context-bar').exists()).toBe(true)
+    // fork behavior: remaining-token text is replaced by the usage percent
+    // chip, and the context progress bar is dropped entirely
+    expect(wrapper.get('.context-info').text()).toContain('0.78%')
+    expect(wrapper.find('.context-bar').exists()).toBe(false)
 
     Object.assign(chatStore.activeSession!, { source: 'cli', agent: 'hermes', codingAgentId: undefined })
     await nextTick()
 
     expect(wrapper.get('.context-info').text()).toMatch(/2\.0k\s+\//)
     expect(wrapper.get('.context-limit-editable').text()).toBe('256.0k')
-    expect(wrapper.find('.context-bar').exists()).toBe(true)
+    expect(wrapper.find('.context-bar').exists()).toBe(false)
   })
 
   it.each(['hermes', 'ekko-agent'])('never substitutes historical usage for missing or zero %s context', async agent => {
@@ -524,12 +526,13 @@ describe('ChatInput draft persistence', () => {
     session.contextTokens = 0
     await nextTick()
     expect(wrapper.get('.context-info').text()).toMatch(/^0\s+\//)
-    expect(wrapper.get('.context-info').text()).toContain('chat.contextRemaining 256.0k')
+    // fork behavior: the remaining-token text is replaced by the usage percent chip
+    expect(wrapper.get('.context-percent').text()).toBe('0.00%')
     for (const value of [undefined, NaN, Infinity, -1]) {
       session.contextTokens = value
       await nextTick()
       expect(wrapper.get('.context-info').text()).toMatch(/^—\s+\//)
-      expect(wrapper.get('.context-info').text()).toContain('chat.contextRemaining —')
+      expect(wrapper.get('.context-percent').text()).toBe('0.00%')
       expect(wrapper.find('.context-bar').exists()).toBe(false)
       expect(wrapper.text()).not.toContain('136.1k')
     }
diff --git a/tests/client/chat-store-search-navigation.test.ts b/tests/client/chat-store-search-navigation.test.ts
index b54f96d12..2032a5642 100644
--- a/tests/client/chat-store-search-navigation.test.ts
+++ b/tests/client/chat-store-search-navigation.test.ts
@@ -176,7 +176,9 @@ describe('search message navigation', () => {
     await expect(pending).resolves.toBe(false)
     expect(store.activeSessionId).toBe('other')
     expect(store.focusMessageId).toBeNull()
-    expect(api.fetchSessionMessagesPage).toHaveBeenCalledTimes(1)
+    // one focus-paging fetch for the search session, plus the fast-first page
+    // that a plain switch to 'other' fires (fork fast-first behavior)
+    expect(api.fetchSessionMessagesPage).toHaveBeenCalledTimes(2)
   })
 
   it('preserves a search result outside the session list when the chat route mounts', async () => {
