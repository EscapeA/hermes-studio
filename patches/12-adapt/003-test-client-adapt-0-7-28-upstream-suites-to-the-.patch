From 551f351220712424b6790f1fd09c9704e6029ce9 Mon Sep 17 00:00:00 2001
From: EscapeA <escapea@users.noreply.github.com>
Date: Sat, 3 Oct 2026 09:56:19 +0800
Subject: [PATCH] test(client): adapt 0.7.28 upstream suites to the fork's
 feature set

---
 tests/client/file-context-menu.test.ts | 11 +++++------
 1 file changed, 5 insertions(+), 6 deletions(-)

diff --git a/tests/client/file-context-menu.test.ts b/tests/client/file-context-menu.test.ts
index b8ba54ba4..72d0d965a 100644
--- a/tests/client/file-context-menu.test.ts
+++ b/tests/client/file-context-menu.test.ts
@@ -14,9 +14,7 @@ const mockDialog = vi.hoisted(() => ({
 }))
 
 const downloadSessionMock = vi.hoisted(() => vi.fn())
-const downloadGroupMock = vi.hoisted(() => vi.fn())
 vi.mock('@/api/studio/sessions', () => ({ downloadSessionWorkspaceFile: downloadSessionMock }))
-vi.mock('@/api/studio/group-chat', () => ({ downloadGroupWorkspaceFile: downloadGroupMock }))
 const downloadFileMock = vi.hoisted(() => vi.fn())
 const copyToClipboardMock = vi.hoisted(() => vi.fn())
 
@@ -156,15 +154,16 @@ describe('FileContextMenu', () => {
 
     expect(workspaceWrapper.emitted('attach')).toEqual([[entry]])
   })
-  it.each(['session', 'group'] as const)('downloads %s workspace files with the authorized scoped API', async scope => {
+  // The fork removes the group-chat frontend, so upstream's `it.each(['session','group'])`
+  // case is narrowed to the session scope it still has code for.
+  it('downloads session workspace files with the authorized scoped API', async () => {
     const store = useFilesStore()
-    if (scope === 'group') store.currentWorkspaceRoomId = 'room-1'
-    else store.currentWorkspaceSessionId = 'session-1'
+    store.currentWorkspaceSessionId = 'session-1'
     const wrapper = mount(FileContextMenu)
     const entry = { name: 'page.html', path: 'tools/page.html', isDir: false, size: 10, modTime: '' }
     await showMenu(wrapper, entry)
     await wrapper.get('[data-key="download"]').trigger('click'); await flushPromises()
-    expect(scope === 'group' ? downloadGroupMock : downloadSessionMock).toHaveBeenCalledWith(scope === 'group' ? 'room-1' : 'session-1', entry.path, entry.name)
+    expect(downloadSessionMock).toHaveBeenCalledWith('session-1', entry.path, entry.name)
     expect(downloadFileMock).not.toHaveBeenCalled()
   })
 
