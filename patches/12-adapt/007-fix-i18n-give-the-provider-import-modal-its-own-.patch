From f9dc544b25f215b4464f5ed1ac1d66ddec0384a7 Mon Sep 17 00:00:00 2001
From: EscapeA <escapea@users.noreply.github.com>
Date: Tue, 20 Oct 2026 21:23:32 +0800
Subject: [PATCH] fix(i18n): give the provider import modal its own profile
 label

Upstream reuses t('workflow.profile') in ProviderImportModal, but the fork
removes the whole workflow namespace, so the label rendered as a raw key and
i18n-coverage flagged it. Add models.profile to every locale and point the
modal at it.
---
 .../client/src/components/hermes/models/ProviderImportModal.vue | 2 +-
 packages/client/src/i18n/locales/ar.ts                          | 1 +
 packages/client/src/i18n/locales/de.ts                          | 1 +
 packages/client/src/i18n/locales/en.ts                          | 1 +
 packages/client/src/i18n/locales/es.ts                          | 1 +
 packages/client/src/i18n/locales/fr.ts                          | 1 +
 packages/client/src/i18n/locales/ja.ts                          | 1 +
 packages/client/src/i18n/locales/ko.ts                          | 1 +
 packages/client/src/i18n/locales/pt.ts                          | 1 +
 packages/client/src/i18n/locales/ru.ts                          | 1 +
 packages/client/src/i18n/locales/tr.ts                          | 1 +
 packages/client/src/i18n/locales/zh-TW.ts                       | 1 +
 packages/client/src/i18n/locales/zh.ts                          | 1 +
 13 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/packages/client/src/components/hermes/models/ProviderImportModal.vue b/packages/client/src/components/hermes/models/ProviderImportModal.vue
index 76dab857b..0b45c0917 100644
--- a/packages/client/src/components/hermes/models/ProviderImportModal.vue
+++ b/packages/client/src/components/hermes/models/ProviderImportModal.vue
@@ -77,7 +77,7 @@ async function save() {
     @update:show="value => { if (!value && !saving) emit('close') }">
     <NAlert type="warning" :show-icon="false">{{ t('models.importNotice') }}</NAlert>
     <NForm label-placement="top" autocomplete="off">
-      <NFormItem :label="t('workflow.profile')" required>
+      <NFormItem :label="t('models.profile')" required>
         <NSelect v-model:value="targetProfile" :disabled="saving"
           :options="profiles.map(p => ({ label: p.name, value: p.name }))" />
       </NFormItem>
