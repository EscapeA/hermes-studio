+describe('调用参数展开入口', () => {
+  it('多行参数在调用行上带可点击的展开标记', () => {
+    const block = renderToolBlock(
+      toolMessage({
+        toolName: 'execute_code',
+        toolArgs: { code: 'from hermes_tools import terminal\nprint(1)\nprint(2)' },
+        toolStatus: 'done',
+        toolResult: '',
