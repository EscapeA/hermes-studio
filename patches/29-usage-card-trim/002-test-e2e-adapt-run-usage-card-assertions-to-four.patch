From f27fe4d8c2f57b52a5e48ad91b42a5fc2256c5dd Mon Sep 17 00:00:00 2001
From: EscapeA <escapea@users.noreply.github.com>
Date: Sat, 3 Oct 2026 01:01:19 +0800
Subject: [PATCH] test(e2e): adapt run usage card assertions to four metrics

The spec asserted the removed cache-rate cell and the cost cell. Output stays
the first cell and the speed cell is still the last metric with its tooltip,
so the remaining assertions hold unchanged.
---
 tests/e2e/chat-streaming.spec.ts | 4 ----
 1 file changed, 4 deletions(-)

diff --git a/tests/e2e/chat-streaming.spec.ts b/tests/e2e/chat-streaming.spec.ts
index 459c4c590..7f232964d 100644
--- a/tests/e2e/chat-streaming.spec.ts
+++ b/tests/e2e/chat-streaming.spec.ts
@@ -1631,8 +1631,6 @@ test('restores per-turn usage cards on resume and reload, including a summary-on
     await expect(cards).toHaveCount(2)
     await expect(cards.first().locator('.run-usage-value').first()).toHaveText('32')
     await expect(cards.last().locator('.run-usage-value').first()).toHaveText('354')
-    await expect(cards.first().locator('.run-usage-cache-rate')).toHaveText('98.1%')
-    await expect(cards.last().locator('.run-usage-cache-rate')).toHaveText('97.2%')
     await expect(cards.first()).toContainText('43.6 tok/s')
     await expect(cards.last()).toContainText('≈ 141.6 tok/s')
     await expect(cards.last()).toContainText('Est. speed')
@@ -1668,8 +1666,6 @@ test('shows completed run usage above diff with matching colors and no disclosur
   await expect(card).toContainText('1,600')
   await expect(card).toContainText('12.4K')
   await expect(card).toContainText('8,000')
-  await expect(card.locator('.run-usage-cache-rate')).toHaveText('64.5%')
-  await expect(card).toContainText('$0.0123')
   await expect(card).toContainText('42.5 tok/s')
   await expect(card.locator('button, [role="button"], details')).toHaveCount(0)
   const diff = page.locator('.assistant-workspace-change')
