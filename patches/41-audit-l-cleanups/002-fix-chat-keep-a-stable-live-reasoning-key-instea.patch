From e11c46638eef2f01f739dd0e6748360a41bdfaec Mon Sep 17 00:00:00 2001
From: EscapeA <escapea@users.noreply.github.com>
Date: Wed, 7 Oct 2026 00:26:54 +0800
Subject: [PATCH] fix(chat): keep a stable live-reasoning key instead of
 churning per token

---
 .../client/src/components/hermes/chat/LiveReasoningStatus.vue   | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/packages/client/src/components/hermes/chat/LiveReasoningStatus.vue b/packages/client/src/components/hermes/chat/LiveReasoningStatus.vue
index 308f565ac..2b0efab25 100644
--- a/packages/client/src/components/hermes/chat/LiveReasoningStatus.vue
+++ b/packages/client/src/components/hermes/chat/LiveReasoningStatus.vue
@@ -44,7 +44,7 @@ watch(
     </div>
     <div
       v-if="reasoning"
-      :key="reasoningId ?? reasoning"
+      :key="reasoningId ?? 'live-reasoning'"
       class="live-reasoning-detail"
       :data-reasoning-id="reasoningId"
     >
