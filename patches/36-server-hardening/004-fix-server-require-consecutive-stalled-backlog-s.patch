From 386f985113faf6bbad60936f4e16c14a52c51c20 Mon Sep 17 00:00:00 2001
From: EscapeA <escapea@users.noreply.github.com>
Date: Wed, 7 Oct 2026 00:04:23 +0800
Subject: [PATCH] fix(server): require consecutive stalled backlog samples
 before killing socket

A single large push could briefly exceed the 256KB write-backlog threshold on
an otherwise healthy link and get the socket force-disconnected. Require the
backlog to stay above the threshold across three consecutive health checks
(and not be draining) before disconnecting, so only a genuinely half-open
socket is recycled.
---
 .../src/modules/studio/sockets/chat-run.ts    | 42 ++++++++++++++-----
 1 file changed, 32 insertions(+), 10 deletions(-)

diff --git a/packages/server/src/modules/studio/sockets/chat-run.ts b/packages/server/src/modules/studio/sockets/chat-run.ts
index 70c5d446b..f3dc60ac2 100644
--- a/packages/server/src/modules/studio/sockets/chat-run.ts
+++ b/packages/server/src/modules/studio/sockets/chat-run.ts
@@ -443,6 +443,8 @@ export class ChatRunSocket {
   private backgroundActivityGraceUntil = 0
   /** socketId → last observed write-backlog bytes (stalled-connection detection) */
   private socketBacklog = new Map<string, number>()
+  /** socketId → consecutive health checks the backlog has stayed above threshold */
+  private socketBacklogStrikes = new Map<string, number>()
   private socketHealthTimer?: NodeJS.Timeout
   private closing = false
   private stopUsageUpdates: () => void
@@ -726,6 +728,13 @@ export class ChatRunSocket {
    */
   private checkSocketHealth(): void {
     const KILL_BACKLOG_BYTES = 256 * 1024
+    // Require several consecutive stalled samples before disconnecting. A single
+    // large push (e.g. a big history page to a phone) can briefly buffer far past
+    // the threshold on an otherwise healthy link. A genuinely half-open socket
+    // keeps the backlog pinned above the threshold across every check, so only a
+    // run of KILL_BACKLOG_STRIKES consecutive over-threshold checks (each one
+    // health-check interval apart) triggers the forced reconnect.
+    const KILL_BACKLOG_STRIKES = 3
     for (const socket of this.nsp.sockets.values()) {
       try {
         const raw = (socket.conn?.transport as any)?.socket as
@@ -734,16 +743,25 @@ export class ChatRunSocket {
         if (!raw || typeof raw.writableLength !== 'number') continue
         const buffered = raw.writableLength || 0
         const prev = this.socketBacklog.get(socket.id)
-        if (buffered > KILL_BACKLOG_BYTES && prev != null && buffered >= prev) {
-          const rooms = Array.from(socket.rooms || [])
-            .filter(room => room.startsWith('session:'))
-            .slice(0, 5)
-          logger.warn(
-            `[chat-run-socket] killing stalled socket (write backlog not draining) socketId=${socket.id} buffered=${buffered} rooms=${rooms.join(',')}`,
-          )
-          socket.disconnect(true)
-          this.socketBacklog.delete(socket.id)
-          continue
+        const overThreshold = buffered > KILL_BACKLOG_BYTES
+        const notDraining = prev == null || buffered >= prev
+        if (overThreshold && notDraining) {
+          const strikes = (this.socketBacklogStrikes.get(socket.id) || 0) + 1
+          if (strikes >= KILL_BACKLOG_STRIKES) {
+            const rooms = Array.from(socket.rooms || [])
+              .filter(room => room.startsWith('session:'))
+              .slice(0, 5)
+            logger.warn(
+              `[chat-run-socket] killing stalled socket (write backlog not draining for ${strikes} checks) socketId=${socket.id} buffered=${buffered} rooms=${rooms.join(',')}`,
+            )
+            socket.disconnect(true)
+            this.socketBacklog.delete(socket.id)
+            this.socketBacklogStrikes.delete(socket.id)
+            continue
+          }
+          this.socketBacklogStrikes.set(socket.id, strikes)
+        } else {
+          this.socketBacklogStrikes.delete(socket.id)
         }
         this.socketBacklog.set(socket.id, buffered)
       } catch {
@@ -753,6 +771,9 @@ export class ChatRunSocket {
     for (const id of Array.from(this.socketBacklog.keys())) {
       if (!this.nsp.sockets.has(id)) this.socketBacklog.delete(id)
     }
+    for (const id of Array.from(this.socketBacklogStrikes.keys())) {
+      if (!this.nsp.sockets.has(id)) this.socketBacklogStrikes.delete(id)
+    }
   }
 
   // --- Auth middleware ---
@@ -3251,6 +3272,7 @@ export class ChatRunSocket {
       this.socketHealthTimer = undefined
     }
     this.socketBacklog.clear()
+    this.socketBacklogStrikes.clear()
     const releaseClaims: Array<Promise<unknown>> = []
     for (const [sessionId, state] of this.sessionMap.entries()) {
       if (state.abortController) {
