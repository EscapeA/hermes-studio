From: EscapeA <escapea@users.noreply.github.com>
Date: Sun, 18 Oct 2026 07:49:19 +0800
Subject: [PATCH] fix(theme): keep the run indicators on palette tokens and
 inset the thinking avatar

fix(theme): keep the run indicators on palette tokens and inset the thinking avatar

Both run indicators hardcoded their colours, so they only worked on the ink
palette, and the thinking avatar's art is a tight crop whose cut-off edge read
as a black border.

- Shimmer bands -> --text-secondary/--text-primary (was a literal #2f3540 dark
  trough at 1.28:1 on the blueprint card, and #ffffff at 1.03:1 on light).
- Session live dot -> --text-primary with an accent halo (was #171717/#f5f5f5,
  which measured 1.1:1 on the blueprint dark card).
- Thinking avatar: inset the art so the cropped shoulders stay off the rim, and
  drop the literal #fff plate in favour of the registered card preset.
- Baseline inventory shrinks by the eleven literals those rules occupied.
---
 .../hermes/chat/LiveReasoningStatus.vue       | 43 +++++++++++++------
 .../hermes/chat/SessionListItem.vue           | 22 +++++-----
 scripts/ui-theme-baseline.json                | 13 +-----
 3 files changed, 43 insertions(+), 35 deletions(-)

diff --git a/packages/client/src/components/hermes/chat/LiveReasoningStatus.vue b/packages/client/src/components/hermes/chat/LiveReasoningStatus.vue
index d38dc3e93..fdf343cd6 100644
--- a/packages/client/src/components/hermes/chat/LiveReasoningStatus.vue
+++ b/packages/client/src/components/hermes/chat/LiveReasoningStatus.vue
@@ -61,9 +61,10 @@ watch(
         @error="($event.target as HTMLImageElement).dataset.agentDeploymentImage = 'error'"
         alt=""
         aria-hidden="true"
-        class="thinking-avatar"
+        class="thinking-avatar thinking-avatar--logo"
+        data-theme-surface="card"
         :data-agent-deployment-target="deploymentSessionId || ''"
-        :class="isEkko ? 'thinking-avatar--animated' : 'thinking-avatar--logo'"
+        :class="isEkko ? 'thinking-avatar--animated' : ''"
       >
       <div class="thinking-status-copy">
         <span class="thinking-status-label">{{ t('chat.thinkingInProgress') }}</span>
@@ -126,10 +127,25 @@ watch(
 }
 
 .thinking-avatar--logo {
-  box-sizing: border-box;
-  padding: calc(5px * var(--spacing-scale, 1));
-  object-fit: contain;
-  background: #fff;
+  // Scope to the static logo branch so the Ekko animation keeps cover-fit and no
+  // plate -- `.thinking-avatar--logo` is static for the harness's ownership check,
+  // so the negation keeps that behaviour explicit.
+  &:not(.thinking-avatar--animated) {
+    box-sizing: border-box;
+    // The logo art is a tight crop: hermes.png runs the character's shoulders into
+    // the bottom edge, so at 32px the cut-off black sat flush against the rounded
+    // corner and read as a black border around the avatar. Insetting the art keeps
+    // that crop off the rim. Tune `--thinking-logo-inset` to move it.
+    --thinking-logo-inset: calc(5px * var(--spacing-scale, 1));
+    padding: var(--thinking-logo-inset);
+    object-fit: contain;
+    // The art carries its own ~50% white background, so this plate stays light: a
+    // dark plate turned the avatar into "white square inside a dark square". Uses
+    // the registered card preset so the plate follows the preset palette; the
+    // artwork is opaque white, so only the inset ring is translucent.
+    background: $bg-card;
+    border-radius: $radius-md;
+  }
 }
 
 .thinking-status-copy {
@@ -151,7 +167,12 @@ watch(
   display: inline-flex;
   align-items: center;
   color: transparent;
-  background: linear-gradient(105deg, $text-secondary 0%, $text-secondary 39%, #ffffff 48%, #ffffff 52%, $text-secondary 61%, $text-secondary 100%);
+  // Shimmer bands are palette tokens, not literals: the travelling highlight may
+  // dim but must never fall into the surface. A hardcoded trough (#2f3540 dark /
+  // #ffffff light) measured 1.2-1.0:1, so a wide slice of the label went black
+  // on dark palettes and white on light ones. Token bands keep the worst case at
+  // 5.49:1 (ink dark), 6.85:1 (blueprint dark), 5.74:1 / 6.24:1 (light presets).
+  background: linear-gradient(105deg, $text-secondary 0%, $text-secondary 39%, $text-primary 48%, $text-primary 52%, $text-secondary 61%, $text-secondary 100%);
   background-size: 300% 100%;
   background-position: 0% 0;
   -webkit-background-clip: text;
@@ -166,12 +187,8 @@ watch(
   will-change: background-position;
 
   .dark & {
-    background: linear-gradient(105deg, #f0f0f0 0%, #f0f0f0 37%, #2f3540 47%, #2f3540 53%, #f0f0f0 63%, #f0f0f0 100%);
-    background-size: 300% 100%;
-    background-position: 0% 0;
-    -webkit-background-clip: text;
-    background-clip: text;
-    filter: drop-shadow(0 0 5px rgba(255, 255, 255, 0.16));
+    // Glow only — the bands stay token-driven above.
+    filter: drop-shadow(0 0 5px rgba(var(--text-primary-rgb), 0.16));
   }
 }
 
diff --git a/packages/client/src/components/hermes/chat/SessionListItem.vue b/packages/client/src/components/hermes/chat/SessionListItem.vue
index d7c8ddea0..7afd0a551 100644
--- a/packages/client/src/components/hermes/chat/SessionListItem.vue
+++ b/packages/client/src/components/hermes/chat/SessionListItem.vue
@@ -298,26 +298,28 @@ onUnmounted(() => {
 
 /* Live/working indicator lives in the title row so it stays visible no matter
    which optional rows (identity, category) the session renders. */
+/* Fill is --text-primary, not a literal near-black/near-white: #171717 and
+   #f5f5f5 only track the ink palette, so on the blueprint dark card (#122436)
+   and its accent-tinted active row the dot measured 1.1-1.3:1 and read as
+   gone. --text-primary is near-black on every light palette and near-white on
+   every dark one, which is the same intent the literals encoded, and keeps the
+   dot at 17.4:1 / 15.5:1 (light) and 10.9:1 / 12.4:1 (dark) — strictly higher
+   than --accent-primary would give on the light palettes. The ring follows the
+   fill; the soft halo is the theme accent so it still reads on the blueprint
+   surface where the old fixed red glow vanished. */
 .session-item-live-dot {
   flex: 0 0 auto;
   width: 7px;
   height: 7px;
   margin-top: 5px;
   border-radius: 50%;
-  background: #171717;
+  background: var(--text-primary);
   box-shadow:
-    0 0 0 2px rgba(23, 23, 23, 0.12),
-    0 0 8px rgba(255, 107, 107, 0.35);
+    0 0 0 2px rgba(var(--text-primary-rgb), 0.16),
+    0 0 8px rgba(var(--accent-primary-rgb), 0.45);
   animation: session-live-pulse 1.5s ease-in-out infinite;
 }
 
-.dark .session-item-live-dot {
-  background: #f5f5f5;
-  box-shadow:
-    0 0 0 2px rgba(245, 245, 245, 0.16),
-    0 0 10px rgba(255, 107, 107, 0.4);
-}
-
 @keyframes session-live-pulse {
   0%,
   100% {
