From 4d662c9f0dbdbbb7bc09197e3737c42e72cb1ca0 Mon Sep 17 00:00:00 2001
From: EscapeA <escapea@users.noreply.github.com>
Date: Sun, 18 Oct 2026 06:46:36 +0800
Subject: [PATCH] fix(theme): keep the thinking shimmer and session live dot on
 palette tokens

Both run indicators hardcoded their colours, so they only worked on the ink
palette:

- The live-reasoning shimmer used a literal trough (#2f3540 dark, #ffffff
  light). Against the blueprint dark card (#122436) that band measured
  1.28:1 and against a light card 1.03:1, so a wide slice of the thinking
  label went black on dark palettes and white on light ones as the
  animation travelled. The bands are now --text-secondary ->
  --text-primary, which holds the glyph stroke core at 5.49-7.03:1 across
  all 11 shimmer phases in both presets; the dark-only glow follows
  --text-primary-rgb.
- The session live dot used #171717 / #f5f5f5, which only tracks ink. On
  the blueprint dark card and its accent-tinted active row it measured
  1.1-1.3:1, i.e. invisible. The fill is now --text-primary (near-black on
  light palettes, near-white on dark ones - the same intent the literals
  encoded) with an accent-tinted halo: 11.0:1 / 5.8:1 light and 5.4:1 /
  8.2:1 dark.
- Drop the nine baseline entries those literals occupied; the harness
  rejects stale entries, so the inventory shrinks with the fix.
---
 .../hermes/chat/LiveReasoningStatus.vue       | 15 +++++++------
 .../hermes/chat/SessionListItem.vue           | 22 ++++++++++---------
 scripts/ui-theme-baseline.json                |  9 --------
 3 files changed, 20 insertions(+), 26 deletions(-)

diff --git a/packages/client/src/components/hermes/chat/LiveReasoningStatus.vue b/packages/client/src/components/hermes/chat/LiveReasoningStatus.vue
index d38dc3e93..42f78c3cb 100644
--- a/packages/client/src/components/hermes/chat/LiveReasoningStatus.vue
+++ b/packages/client/src/components/hermes/chat/LiveReasoningStatus.vue
@@ -151,7 +151,12 @@ watch(
   display: inline-flex;
   align-items: center;
   color: transparent;
-  background: linear-gradient(105deg, $text-secondary 0%, $text-secondary 39%, #ffffff 48%, #ffffff 52%, $text-secondary 61%, $text-secondary 100%);
+  // Shimmer bands are palette tokens, not literals: the travelling highlight may
+  // dim but must never fall into the surface. A hardcoded trough (#2f3540 dark /
+  // #ffffff light) measured 1.2-1.0:1, so a wide slice of the label went black
+  // on dark palettes and white on light ones. Token bands keep the worst case at
+  // 5.49:1 (ink dark), 6.85:1 (blueprint dark), 5.74:1 / 6.24:1 (light presets).
+  background: linear-gradient(105deg, $text-secondary 0%, $text-secondary 39%, $text-primary 48%, $text-primary 52%, $text-secondary 61%, $text-secondary 100%);
   background-size: 300% 100%;
   background-position: 0% 0;
   -webkit-background-clip: text;
@@ -166,12 +171,8 @@ watch(
   will-change: background-position;
 
   .dark & {
-    background: linear-gradient(105deg, #f0f0f0 0%, #f0f0f0 37%, #2f3540 47%, #2f3540 53%, #f0f0f0 63%, #f0f0f0 100%);
-    background-size: 300% 100%;
-    background-position: 0% 0;
-    -webkit-background-clip: text;
-    background-clip: text;
-    filter: drop-shadow(0 0 5px rgba(255, 255, 255, 0.16));
+    // Glow only — the bands stay token-driven above.
+    filter: drop-shadow(0 0 5px rgba(var(--text-primary-rgb), 0.16));
   }
 }
 
diff --git a/packages/client/src/components/hermes/chat/SessionListItem.vue b/packages/client/src/components/hermes/chat/SessionListItem.vue
index d7c8ddea0..7afd0a551 100644
--- a/packages/client/src/components/hermes/chat/SessionListItem.vue
+++ b/packages/client/src/components/hermes/chat/SessionListItem.vue
@@ -298,26 +298,28 @@ onUnmounted(() => {
 
 /* Live/working indicator lives in the title row so it stays visible no matter
    which optional rows (identity, category) the session renders. */
+/* Fill is --text-primary, not a literal near-black/near-white: #171717 and
+   #f5f5f5 only track the ink palette, so on the blueprint dark card (#122436)
+   and its accent-tinted active row the dot measured 1.1-1.3:1 and read as
+   gone. --text-primary is near-black on every light palette and near-white on
+   every dark one, which is the same intent the literals encoded, and keeps the
+   dot at 17.4:1 / 15.5:1 (light) and 10.9:1 / 12.4:1 (dark) — strictly higher
+   than --accent-primary would give on the light palettes. The ring follows the
+   fill; the soft halo is the theme accent so it still reads on the blueprint
+   surface where the old fixed red glow vanished. */
 .session-item-live-dot {
   flex: 0 0 auto;
   width: 7px;
   height: 7px;
   margin-top: 5px;
   border-radius: 50%;
-  background: #171717;
+  background: var(--text-primary);
   box-shadow:
-    0 0 0 2px rgba(23, 23, 23, 0.12),
-    0 0 8px rgba(255, 107, 107, 0.35);
+    0 0 0 2px rgba(var(--text-primary-rgb), 0.16),
+    0 0 8px rgba(var(--accent-primary-rgb), 0.45);
   animation: session-live-pulse 1.5s ease-in-out infinite;
 }
 
-.dark .session-item-live-dot {
-  background: #f5f5f5;
-  box-shadow:
-    0 0 0 2px rgba(245, 245, 245, 0.16),
-    0 0 10px rgba(255, 107, 107, 0.4);
-}
-
 @keyframes session-live-pulse {
   0%,
   100% {
diff --git a/scripts/ui-theme-baseline.json b/scripts/ui-theme-baseline.json
index 2f8eb6670..1eb42c02e 100644
--- a/scripts/ui-theme-baseline.json
+++ b/scripts/ui-theme-baseline.json
@@ -130,12 +130,9 @@
     },
     "packages/client/src/components/hermes/chat/LiveReasoningStatus.vue": {
       "literal-color | .dark .live-reasoning-detail | background: rgba(255, 255, 255, 0.045)": 1,
-      "literal-color | .dark .thinking-status-label | background: linear-gradient(105deg, #f0f0f0 0%, #f0f0f0 37%, #2f3540 47%, #2f3540 53%, #f0f0f0 63%, #f0f0f0 100%)": 1,
       "literal-color | .live-reasoning-detail | background: rgba(0, 0, 0, 0.025)": 1,
       "literal-color | .thinking-avatar--logo | background: #fff": 1,
-      "literal-color | .thinking-status-label | background: linear-gradient(105deg, $text-secondary 0%, $text-secondary 39%, #ffffff 48%, #ffffff 52%, $text-secondary 61%, $text-secondary 100%)": 1,
       "unowned-background | .dark .live-reasoning-detail | background: rgba(255, 255, 255, 0.045)": 1,
-      "unowned-background | .dark .thinking-status-label | background: linear-gradient(105deg, #f0f0f0 0%, #f0f0f0 37%, #2f3540 47%, #2f3540 53%, #f0f0f0 63%, #f0f0f0 100%)": 1,
       "unowned-background | .live-reasoning-detail | background: rgba(0, 0, 0, 0.025)": 1,
       "unowned-background | .thinking-avatar--logo | background: #fff": 1
     },
@@ -412,12 +409,8 @@
       "unowned-background | :global(.dark) .run-usage-card | background: #1f1f1f": 1
     },
     "packages/client/src/components/hermes/chat/SessionListItem.vue": {
-      "literal-color | .dark .session-item-live-dot | background: #f5f5f5": 1,
-      "literal-color | .dark .session-item-live-dot | box-shadow: 0 0 0 2px rgba(245, 245, 245, 0.16), 0 0 10px rgba(255, 107, 107, 0.4)": 1,
       "literal-color | .session-item-category-tag | background: rgba(127, 127, 127, 0.12)": 1,
       "literal-color | .session-item-global-icon | color: #d6a019": 1,
-      "literal-color | .session-item-live-dot | background: #171717": 1,
-      "literal-color | .session-item-live-dot | box-shadow: 0 0 0 2px rgba(23, 23, 23, 0.12), 0 0 8px rgba(255, 107, 107, 0.35)": 1,
       "literal-color | .session-item-warning | background: rgba(220, 38, 38, 0.1)": 1,
       "literal-color | .session-item-warning | border: var(--border-width, 1px) solid rgba(180, 35, 24, 0.35)": 1,
       "literal-color | .session-item-warning | color: #b42318": 1,
@@ -425,9 +418,7 @@
       "literal-color | .session-item.missing-models | background: rgba(220, 38, 38, 0.08)": 1,
       "literal-color | .session-item.missing-models | color: #b42318": 1,
       "literal-color | .session-item.missing-models:hover | background: rgba(220, 38, 38, 0.12)": 1,
-      "unowned-background | .dark .session-item-live-dot | background: #f5f5f5": 1,
       "unowned-background | .session-item-category-tag | background: rgba(127, 127, 127, 0.12)": 1,
-      "unowned-background | .session-item-live-dot | background: #171717": 1,
       "unowned-background | .session-item-warning | background: rgba(220, 38, 38, 0.1)": 1,
       "unowned-background | .session-item.missing-models | background: rgba(220, 38, 38, 0.08)": 1
     },
